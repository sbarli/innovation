{
  "name": "@inno/api-contracts",
  "version": "0.0.1",
  "description": "ts-rest API contract definitions shared between backend and frontend",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ts-rest/core": "^3.51.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsconfig": "workspace:*",
    "typescript": "^5.8.3"
  }
}
