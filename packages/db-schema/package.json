{
  "name": "@inno/db-schema",
  "version": "0.0.1",
  "description": "Drizzle ORM schema definitions for the Innovation game database",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0"
  },
  "devDependencies": {
    "@inno/constants": "workspace:*",
    "tsconfig": "workspace:*",
    "typescript": "^5.8.3"
  }
}
