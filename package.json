{
  "name": "@inno/root",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@inno/backend",
    "dev:native": "turbo run dev --filter=@inno/native",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:staged": "lint-staged",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean",
    "tb:clean": "turbo clean && turbo daemon clean",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": ["eslint --quiet --fix"]
  },
  "devDependencies": {
    "@inno/eslint-custom": "workspace:*",
    "eslint": "^9.24.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.0.2",
    "prettier": "^3.5.3",
    "tsconfig": "workspace:*",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.10.0"
}
