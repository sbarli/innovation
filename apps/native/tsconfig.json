{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "tsconfig/expo.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@/*": ["./src/*"],
      "@inno/*": ["../../packages/*/src"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "expo-env.d.ts",
    "index.js"
  ],
  "exclude": ["node_modules", "dist"]
}
