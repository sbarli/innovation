{
  "name": "@inno/native",
  "version": "0.0.1",
  "description": "Innovation game native app — Expo + react-native-web",
  "author": "Samantha Barli",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "doppler run --project native --config dev -- expo start",
    "android": "doppler run --project native --config dev -- expo start --android",
    "ios": "doppler run --project native --config dev -- expo start --ios",
    "web": "doppler run --project native --config dev -- expo start --web",
    "dev": "doppler run --project native --config dev -- expo start",
    "build": "echo 'Use EAS Build for production builds'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inno/api-contracts": "workspace:*",
    "@inno/constants": "workspace:*",
    "@inno/ui": "workspace:*",
    "@inno/utils": "workspace:*",
    "@hookform/resolvers": "^3.9.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tamagui/config": "2.0.0-rc.42",
    "@tamagui/core": "2.0.0-rc.42",
    "@tamagui/font-inter": "2.0.0-rc.42",
    "@tanstack/react-query": "^5.62.7",
    "@ts-rest/core": "^3.51.0",
    "@ts-rest/react-query": "^3.51.0",
    "@expo/metro-runtime": "~55.0.3",
    "expo": "~55.0.0",
    "expo-font": "~55.0.7",
    "expo-linking": "~55.0.3",
    "expo-router": "~55.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.54.2",
    "react-native": "0.83.9",
    "react-native-web": "~0.21.2",
    "socket.io-client": "^4.8.1",
    "tamagui": "2.0.0-rc.42",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "@inno/eslint-custom": "workspace:*",
    "@tamagui/babel-plugin": "2.0.0-rc.42",
    "@tamagui/vite-plugin": "2.0.0-rc.42",
    "@types/react": "~19.2.6",
    "@types/react-dom": "~19.2.3",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "tsconfig": "workspace:*",
    "typescript": "^5.8.3"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}