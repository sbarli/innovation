{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "tsconfig/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "incremental": true,
    "baseUrl": "./",
    "paths": {
      "@inno/*": ["../../packages/*/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
